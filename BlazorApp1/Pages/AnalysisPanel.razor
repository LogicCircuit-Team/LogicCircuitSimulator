@using LogicCore.Management
@using LogicCore.Analysis
@using BlazorApp1.Services
@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms

@inject HdlImportClient ImportClient

<div class="d-flex flex-column gap-3 analysis-stack">

    <section class="card shadow-sm" aria-label="Truth table">
        <div class="card-header bg-light py-3">
            <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
                <div>
                    <h2 class="h6 fw-bold mb-1">Truth Table</h2>
                    <p class="small text-muted mb-0">View the circuit's input and output combinations.</p>
                </div>

                @if (resultsDirty)
                {
                    <span class="badge bg-secondary">Not generated</span>
                }
                else
                {
                    <span class="badge bg-success">Generated</span>
                }
            </div>
        </div>

        <div class="card-body">
            <button class="btn btn-primary w-100 mb-3"
                    @onclick="GenerateTruthTable"
                    type="button">
                Generate Truth Table
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 text-break" role="alert">
                    @errorMessage
                </div>
            }

            @if (resultsDirty)
            {
                <div class="border rounded bg-light p-3 text-center">
                    <p class="small text-muted mb-0">
                        Generate the truth table to view the current results.
                    </p>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <span class="small fw-bold">Results</span>
                    <span class="badge bg-light text-dark border">@rows.Count rows</span>
                </div>

                <div class="table-responsive border rounded"
                     style="max-height: 340px; overflow-y: auto;"
                     tabindex="0"
                     role="region"
                     aria-label="Truth table results">
                    <table class="table table-sm table-striped table-hover table-bordered align-middle text-center mb-0">
                        <caption class="visually-hidden">Circuit input and output values</caption>
                        <thead class="table-light">
                            <tr>
                                @foreach (var item in generator.InputIds)
                                {
                                    <th scope="col" class="px-3 py-2">
                                        <span class="badge bg-primary mb-1">Input</span>
                                        <span class="d-block font-monospace">@item</span>
                                    </th>
                                }

                                @foreach (var item in generator.OutputIds)
                                {
                                    <th scope="col" class="px-3 py-2">
                                        <span class="badge bg-success mb-1">Output</span>
                                        <span class="d-block font-monospace">@item</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in rows)
                            {
                                <tr>
                                    @foreach (var item in row.InputValues)
                                    {
                                        <td class="font-monospace py-2">@Convert.ToInt32(item)</td>
                                    }
                                    @foreach (var item in row.OutputValues)
                                    {
                                        <td class="font-monospace py-2">@Convert.ToInt32(item)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm" aria-label="Export HDL">
        <div class="card-header bg-light py-3">
            <h2 class="h6 fw-bold mb-1">Export HDL</h2>
            <p class="small text-muted mb-0">Generate Verilog or SystemVerilog from the circuit.</p>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label for="analysis-module-name" class="form-label small fw-bold">
                    Module name
                </label>
                <input id="analysis-module-name"
                       type="text"
                       class="form-control font-monospace"
                       @bind="moduleName"
                       @bind:after="InvalidateVerilog"
                       placeholder="demo"
                       aria-describedby="analysis-module-help"
                       spellcheck="false"
                       dir="ltr" />
                <div id="analysis-module-help" class="form-text">
                    Used as the module name and download filename.
                </div>
            </div>

            <div class="form-check form-switch mb-3">
                <input id="analysis-use-system-verilog"
                       type="checkbox"
                       class="form-check-input"
                       role="switch"
                       @bind="useSystemVerilog"
                       @bind:after="InvalidateVerilog" />
                <label for="analysis-use-system-verilog" class="form-check-label small">
                    Use SystemVerilog (.sv)
                </label>
            </div>

            <button type="button"
                    class="btn btn-outline-primary w-100"
                    @onclick="GenerateVerilog">
                Generate Verilog
            </button>

            @if (!string.IsNullOrEmpty(verilogErrorMessage))
            {
                <div class="alert alert-danger py-2 mt-3 mb-0 text-break" role="alert">
                    @verilogErrorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(verilogText))
            {
                <div class="border rounded overflow-hidden mt-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 bg-light border-bottom p-2">
                        <span class="small font-monospace text-break">
                            @GetDownloadFileName()
                        </span>
                        <a href="@GetVerilogDownloadUrl()"
                               download="@GetDownloadFileName()"
                               class="btn btn-primary btn-sm">
                            Download
                        </a>
                    </div>

                    <pre class="bg-dark text-light small p-3 mb-0"
                         style="max-height: 340px; overflow: auto;"
                         tabindex="0"
                         aria-label="Generated HDL code"
                         dir="ltr"><code>@verilogText</code></pre>
                </div>
            }
        </div>
    </section>

    <section class="card shadow-sm" aria-label="Import HDL">
        <div class="card-header bg-light py-3">
            <h2 class="h6 fw-bold mb-1">Import HDL</h2>
            <p class="small text-muted mb-0">Open a .sv or .v file, or paste HDL code and choose its top module.</p>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <label for="analysis-hdl-file" class="form-label small fw-bold">Open HDL file (.sv, .v)</label>
                <InputFile id="analysis-hdl-file" class="form-control mb-2"
                           OnChange="LoadHdlFileAsync" accept=".sv,.v,text/plain" disabled="@isImporting" />
                @if (!string.IsNullOrEmpty(hdlFileName))
                {
                    <p class="small text-muted">Loaded file: @hdlFileName</p>
                }
                <label for="analysis-hdl-code" class="form-label small fw-bold">
                    HDL code
                </label>
                <textarea id="analysis-hdl-code"
                          class="form-control font-monospace small"
                          @bind="hdlText"
                          @bind:event="oninput"
                          @bind:after="SuggestTopModule"
                          rows="8"
                          disabled="@isImporting"
                          placeholder="Paste your HDL code here..."
                          spellcheck="false"
                          dir="ltr"></textarea>
            </div>

            <div class="mb-3">
                <label for="analysis-top-module" class="form-label small fw-bold">
                    Top module
                </label>
                <input id="analysis-top-module"
                       type="text"
                       class="form-control font-monospace"
                       @bind="importTopModule"
                       disabled="@isImporting"
                       placeholder="demo"
                       spellcheck="false"
                       dir="ltr" />
            </div>

            <button type="button"
                    @onclick="ImportFromVerilog"
                    disabled="@isImporting"
                    class="btn btn-success w-100 d-inline-flex align-items-center justify-content-center gap-2">
                @if (isImporting)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                <span>Import HDL</span>
            </button>

            @if (isImporting)
            {
                <p class="small text-info mt-3 mb-0" role="status">
                    Importing HDL...
                </p>
            }

            @if (!string.IsNullOrEmpty(importErrorMessage))
            {
                <div class="alert alert-danger py-2 mt-3 mb-0 text-break" role="alert">
                    @GetImportErrorSummary()
                </div>
                @if (importErrorMessage.Length > 300 || importErrorMessage.Contains('\n'))
                {
                    <details class="import-details mt-2">
                        <summary>View details</summary>
                        <pre>@importErrorMessage</pre>
                    </details>
                }
            }

            @if (!string.IsNullOrEmpty(importDiagnostics))
            {
                <div class="border rounded bg-light mt-3">
                    <div class="small fw-bold border-bottom px-3 py-2">Diagnostics</div>
                    <pre class="small p-3 mb-0"
                         style="max-height: 240px; overflow: auto;"
                         tabindex="0"
                         aria-label="Import diagnostics"
                         dir="ltr">@importDiagnostics</pre>
                </div>
            }
        </div>
    </section>

</div>

@code {
    [Parameter]
    public CircuitManager Manager { get; set; } = default!;

    [Parameter]
    public EventCallback OnCircuitChanged { get; set; }

    private YosysNetlistAdapter adapter = new YosysNetlistAdapter();
    private string hdlText = string.Empty;
    private string hdlFileName = string.Empty;
    private string importTopModule = "demo";
    private string previousSuggestion = "demo";

    private void SuggestTopModule()
    {
        var file = new HdlSourceFile { Source = hdlText, FileName = hdlFileName };
        string suggested = file.FindTopModule();
        if (!string.IsNullOrWhiteSpace(suggested))
        {
            if (string.IsNullOrWhiteSpace(importTopModule) || importTopModule == previousSuggestion)
                importTopModule = suggested;
            previousSuggestion = suggested;
        }
    }

    private bool isImporting = false;
    private string importErrorMessage = string.Empty;
    private string importDiagnostics = string.Empty;

    private VerilogTranslator translator = new VerilogTranslator();
    private List<TruthTableRow> rows = new List<TruthTableRow>();
    private TruthTableGenerator generator = new TruthTableGenerator();
    private bool resultsDirty = true;
    private string errorMessage = string.Empty;
    private string moduleName = "demo";
    private bool useSystemVerilog = true;
    private string verilogText = string.Empty;
    private string verilogErrorMessage = string.Empty;
    private string GetImportErrorSummary()
    {
        string firstLine = importErrorMessage.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? importErrorMessage;
        return firstLine.Length > 300 ? firstLine[..300] + "..." : firstLine;
    }

    private string GetDownloadFileName()
    {
        if (useSystemVerilog)
        {
            return moduleName + ".sv";
        }
        else
        {
            return moduleName + ".v";
        }
    }

    private string GetVerilogDownloadUrl()
    {
        string encodedText = Uri.EscapeDataString(verilogText);
        return "data:text/plain;charset=utf-8," + encodedText;
    }

    public void GenerateAnalysis()
    {
        resultsDirty = true;
        InvalidateVerilog();
        StateHasChanged();
    }

    private void GenerateTruthTable()
    {
        errorMessage = string.Empty;
        try
        {
            rows = generator.Generate(Manager);
            resultsDirty = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            resultsDirty = true;
            rows.Clear();
        }
    }

    private void InvalidateVerilog()
    {
        verilogText = string.Empty;
        verilogErrorMessage = string.Empty;
    }

    private void GenerateVerilog()
    {
        InvalidateVerilog();
        try
        {
            verilogText = translator.ExportToVerilog(Manager, moduleName, useSystemVerilog);
        }
        catch (Exception ex)
        {
            verilogErrorMessage = ex.Message;
        }
    }

    private async Task LoadHdlFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            string extension = Path.GetExtension(e.File.Name);
            if (!extension.Equals(".sv", StringComparison.OrdinalIgnoreCase) &&
                !extension.Equals(".v", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Select a .sv or .v file.");
            await using var stream = e.File.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            await ImportHdlFileAsync(new HdlSourceFile
            {
                FileName = e.File.Name,
                Source = await reader.ReadToEndAsync()
            });
        }
        catch (Exception ex)
        {
            importErrorMessage = ex.Message;
        }
    }

    public async Task ImportHdlFileAsync(HdlSourceFile file)
    {
        if (isImporting)
            throw new InvalidOperationException("Wait for the current HDL import to finish.");
        hdlText = file.Source;
        hdlFileName = file.FileName;
        importTopModule = file.FindTopModule();
        previousSuggestion = importTopModule;
        await ImportFromVerilog();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ImportFromVerilog()
    {
        if (isImporting)
        {
            return;
        }

        importErrorMessage = string.Empty;
        importDiagnostics = string.Empty;

        if (string.IsNullOrWhiteSpace(hdlText))
        {
            importErrorMessage = "HDL code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(importTopModule))
        {
            importErrorMessage = "Top module name is required.";
            return;
        }

        isImporting = true;
        await InvokeAsync(StateHasChanged);
        bool circuitImported = false;

        try
        {
            HdlSynthesisRequest request = new HdlSynthesisRequest
            {
                Source = hdlText,
                TopModule = importTopModule
            };

            HdlSynthesisResponse result = await ImportClient.SynthesizeAsync(request);

            importDiagnostics = result.Diagnostics;

            CircuitManager temporaryManager = adapter.ImportFromJson(result.NetlistJson, request.TopModule);

            Manager.ReplaceWith(temporaryManager);

            rows.Clear();
            errorMessage = string.Empty;
            resultsDirty = true;
            InvalidateVerilog();

            circuitImported = true;
            await OnCircuitChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            importErrorMessage = circuitImported
                ? $"The circuit was imported, but refreshing the board failed: {ex.Message}"
                : ex.Message;
        }
        finally
        {
            isImporting = false;
        }
    }
}

