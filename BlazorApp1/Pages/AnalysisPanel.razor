@using LogicCore.Management
@using LogicCore.Analysis
@using BlazorApp1.Services
@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web.Virtualization

@inject HdlImportClient ImportClient
@inject IJSRuntime JS

<section class="analysis-tools" aria-label="Analysis tools">
    <p class="analysis-intro">Choose a tool to open it in a larger workspace.</p>
    <button type="button" class="analysis-tool analysis-tool-primary" data-truth-table aria-haspopup="dialog" aria-controls="truth-table-dialog">
        <span class="analysis-tool-icon"><i class="bi bi-table" aria-hidden="true"></i></span>
        <span class="analysis-tool-copy"><strong>Truth Table</strong><small>Explore every input combination</small></span>
        <i class="bi bi-arrows-fullscreen analysis-tool-arrow" aria-hidden="true"></i>
    </button>
    <button type="button" class="analysis-tool" data-analysis-dialog="export-hdl-dialog" aria-haspopup="dialog" aria-controls="export-hdl-dialog">
        <span class="analysis-tool-icon"><i class="bi bi-code-slash" aria-hidden="true"></i></span>
        <span class="analysis-tool-copy"><strong>Export HDL</strong><small>Generate and download Verilog</small></span>
        <i class="bi bi-arrows-fullscreen analysis-tool-arrow" aria-hidden="true"></i>
    </button>
    <button type="button" class="analysis-tool" data-analysis-dialog="import-hdl-dialog" aria-haspopup="dialog" aria-controls="import-hdl-dialog">
        <span class="analysis-tool-icon"><i class="bi bi-upload" aria-hidden="true"></i></span>
        <span class="analysis-tool-copy"><strong>Import HDL</strong><small>Build a circuit from .sv or .v</small></span>
        <i class="bi bi-arrows-fullscreen analysis-tool-arrow" aria-hidden="true"></i>
    </button>
</section>

<dialog id="truth-table-dialog" class="analysis-dialog truth-dialog" aria-labelledby="truth-table-dialog-title" aria-describedby="truth-table-dialog-description">
    <div class="modal-content">
        <header class="modal-header">
            <span class="dialog-title-icon"><i class="bi bi-table" aria-hidden="true"></i></span>
            <div class="dialog-heading">
                <h2 id="truth-table-dialog-title" class="modal-title">Truth Table</h2>
                <p id="truth-table-dialog-description">Every input combination, with its resulting outputs.</p>
            </div>
            <button type="button" class="btn dialog-expand" data-dialog-expand aria-label="Expand window" aria-pressed="false" title="Expand window"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
            <button type="button" class="btn-close" data-dialog-close aria-label="Close Truth Table" title="Close Truth Table"></button>
        </header>
        <div class="modal-body accordion-body">
            <button class="btn btn-primary mb-3" data-truth-generate
                    @onclick="GenerateTruthTable"
                    type="button">
                Generate Truth Table
            </button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger py-2 text-break" role="alert">
                    @errorMessage
                </div>
            }

            @if (resultsDirty)
            {
                <div class="border rounded bg-light p-3 text-center">
                    <p class="small text-muted mb-0">
                        Generate the truth table to view the current results.
                    </p>
                </div>
            }
            else
            {
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-2">
                    <span class="small fw-bold">Results</span>
                    <span class="badge bg-label-secondary">@rows.Count rows</span>
                </div>

                <div class="table-responsive border rounded truth-result-wrap"
                     style="max-height: 420px; overflow-y: auto;"
                     tabindex="0"
                     role="region"
                     aria-label="Truth table results">
                    <table class="table table-sm table-striped table-hover align-middle text-center mb-0">
                        <caption class="visually-hidden">Circuit input and output values</caption>
                        <thead class="table-light sticky-top">
                            <tr>
                                @foreach (var item in generator.InputIds)
                                {
                                    <th scope="col" class="px-3 py-2">
                                        <span class="badge bg-label-primary mb-1">Input</span>
                                        <span class="d-block font-monospace">@item</span>
                                    </th>
                                }

                                @foreach (var item in generator.OutputIds)
                                {
                                    <th scope="col" class="px-3 py-2">
                                        <span class="badge bg-label-success mb-1">Output</span>
                                        <span class="d-block font-monospace">@item</span>
                                    </th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            <Virtualize Items="@rows" Context="row" ItemSize="36" OverscanCount="10">
                                <tr>
                                    @foreach (var item in row.InputValues)
                                    {
                                        <td class="font-monospace py-2">@(item ? 1 : 0)</td>
                                    }
                                    @foreach (var item in row.OutputValues)
                                    {
                                        <td class="font-monospace py-2">@(item ? 1 : 0)</td>
                                    }
                                </tr>
                            </Virtualize>
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <footer class="modal-footer">
            <span class="dialog-footer-note"><span class="signal-zero">0</span> LOW <span class="signal-one">1</span> HIGH</span>
            <button type="button" class="btn btn-outline-secondary" data-dialog-close>Back to circuit</button>
        </footer>
    </div>
</dialog>

<dialog id="export-hdl-dialog" class="analysis-dialog hdl-dialog" aria-labelledby="export-hdl-dialog-title" aria-describedby="export-hdl-dialog-description">
    <div class="modal-content">
        <header class="modal-header">
            <span class="dialog-title-icon"><i class="bi bi-code-slash" aria-hidden="true"></i></span>
            <div class="dialog-heading">
                <h2 id="export-hdl-dialog-title" class="modal-title">Export HDL</h2>
                <p id="export-hdl-dialog-description">Generate Verilog or SystemVerilog from your circuit.</p>
            </div>
            <button type="button" class="btn dialog-expand" data-dialog-expand aria-label="Expand window" aria-pressed="false" title="Expand window"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
            <button type="button" class="btn-close" data-dialog-close aria-label="Close Export HDL" title="Close Export HDL"></button>
        </header>
        <div class="modal-body accordion-body">
            <div class="mb-3">
                <label for="analysis-module-name" class="form-label small fw-bold">
                    Module name
                </label>
                <input id="analysis-module-name"
                       type="text"
                       class="form-control font-monospace"
                       @bind="moduleName"
                       @bind:after="InvalidateVerilog"
                       placeholder="demo"
                       aria-describedby="analysis-module-help"
                       spellcheck="false"
                       dir="ltr" />
                <div id="analysis-module-help" class="form-text">
                    Used as the module name and download filename.
                </div>
            </div>

            <div class="form-check form-switch mb-3">
                <input id="analysis-use-system-verilog"
                       type="checkbox"
                       class="form-check-input"
                       role="switch"
                       @bind="useSystemVerilog"
                       @bind:after="InvalidateVerilog" />
                <label for="analysis-use-system-verilog" class="form-check-label small">
                    Use SystemVerilog (.sv)
                </label>
            </div>

            <button type="button"
                    class="btn btn-outline-primary w-100"
                    @onclick="GenerateVerilog">
                Generate Verilog
            </button>

            @if (!string.IsNullOrEmpty(verilogErrorMessage))
            {
                <div class="alert alert-danger py-2 mt-3 mb-0 text-break" role="alert">
                    @verilogErrorMessage
                </div>
            }

            @if (!string.IsNullOrEmpty(verilogText))
            {
                <div class="border rounded overflow-hidden mt-3">
                    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 bg-light border-bottom p-2">
                        <span class="small font-monospace text-break">
                            @GetDownloadFileName()
                        </span>
                        <button type="button"
                                class="btn btn-primary btn-sm"
                                @onclick="DownloadVerilogAsync">
                            Download
                        </button>
                    </div>

                    <pre class="bg-dark text-light small p-3 mb-0"
                         style="max-height: 340px; overflow: auto;"
                         tabindex="0"
                         aria-label="Generated HDL code"
                         dir="ltr"><code>@verilogText</code></pre>
                </div>
            }
        </div>
        <footer class="modal-footer">
            <span class="dialog-footer-note">Download your circuit as a .v or .sv file.</span>
            <button type="button" class="btn btn-outline-secondary" data-dialog-close>Back to circuit</button>
        </footer>
    </div>
</dialog>

<dialog id="import-hdl-dialog" class="analysis-dialog hdl-dialog" aria-labelledby="import-hdl-dialog-title" aria-describedby="import-hdl-dialog-description">
    <div class="modal-content">
        <header class="modal-header">
            <span class="dialog-title-icon"><i class="bi bi-upload" aria-hidden="true"></i></span>
            <div class="dialog-heading">
                <h2 id="import-hdl-dialog-title" class="modal-title">Import HDL</h2>
                <p id="import-hdl-dialog-description">Open an HDL file or paste code to build a circuit.</p>
            </div>
            <button type="button" class="btn dialog-expand" data-dialog-expand aria-label="Expand window" aria-pressed="false" title="Expand window"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
            <button type="button" class="btn-close" data-dialog-close aria-label="Close Import HDL" title="Close Import HDL"></button>
        </header>
        <div class="modal-body accordion-body">
            <div class="mb-3">
                <label for="analysis-hdl-file" class="form-label small fw-bold">Open HDL file (.sv, .v)</label>
                <InputFile id="analysis-hdl-file" class="form-control mb-2"
                           OnChange="LoadHdlFileAsync" accept=".sv,.v,text/plain" disabled="@isImporting" />
                @if (!string.IsNullOrEmpty(hdlFileName))
                {
                    <p class="small text-muted">Loaded file: @hdlFileName</p>
                }
                <label for="analysis-hdl-code" class="form-label small fw-bold">
                    HDL code
                </label>
                <textarea id="analysis-hdl-code"
                          class="form-control font-monospace small"
                          @bind="hdlText"
                          @bind:event="oninput"
                          @bind:after="SuggestTopModule"
                          rows="8"
                          disabled="@isImporting"
                          placeholder="Paste your HDL code here..."
                          spellcheck="false"
                          dir="ltr"></textarea>
            </div>

            <div class="mb-3">
                <label for="analysis-top-module" class="form-label small fw-bold">
                    Top module
                </label>
                <input id="analysis-top-module"
                       type="text"
                       class="form-control font-monospace"
                       @bind="importTopModule"
                       disabled="@isImporting"
                       placeholder="demo"
                       spellcheck="false"
                       dir="ltr" />
            </div>

            <button type="button"
                    @onclick="ImportFromVerilog"
                    disabled="@isImporting"
                    class="btn btn-primary w-100 d-inline-flex align-items-center justify-content-center gap-2">
                @if (isImporting)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                }
                <span>Import HDL</span>
            </button>

            @if (isImporting)
            {
                <p class="small text-info mt-3 mb-0" role="status">
                    Importing HDL...
                </p>
            }

            @if (!string.IsNullOrEmpty(importErrorMessage))
            {
                <div class="alert alert-danger py-2 mt-3 mb-0 text-break" role="alert">
                    @GetImportErrorSummary()
                </div>
                @if (importErrorMessage.Length > 300 || importErrorMessage.Contains('\n'))
                {
                    <details class="import-details mt-2">
                        <summary>View details</summary>
                        <pre>@importErrorMessage</pre>
                    </details>
                }
            }

            @if (!string.IsNullOrEmpty(importDiagnostics))
            {
                <div class="border rounded bg-light mt-3">
                    <div class="small fw-bold border-bottom px-3 py-2">Diagnostics</div>
                    <pre class="small p-3 mb-0"
                         style="max-height: 240px; overflow: auto;"
                         tabindex="0"
                         aria-label="Import diagnostics"
                         dir="ltr">@importDiagnostics</pre>
                </div>
            }
        </div>
        <footer class="modal-footer">
            <span class="dialog-footer-note">Import replaces the current circuit after validation.</span>
            <button type="button" class="btn btn-outline-secondary" data-dialog-close>Back to circuit</button>
        </footer>
    </div>
</dialog>

@code {
    [Parameter]
    public CircuitManager Manager { get; set; } = default!;

    [Parameter]
    public EventCallback OnCircuitChanged { get; set; }

    private readonly YosysNetlistAdapter adapter = new();
    private string hdlText = string.Empty;
    private string hdlFileName = string.Empty;
    private string importTopModule = "demo";
    private string previousSuggestion = "demo";

    private void SuggestTopModule()
    {
        var file = new HdlSourceFile { Source = hdlText, FileName = hdlFileName };
        string suggested = file.FindTopModule();
        if (!string.IsNullOrWhiteSpace(suggested))
        {
            if (string.IsNullOrWhiteSpace(importTopModule) || importTopModule == previousSuggestion)
                importTopModule = suggested;
            previousSuggestion = suggested;
        }
    }

    private bool isImporting;
    private string importErrorMessage = string.Empty;
    private string importDiagnostics = string.Empty;

    private readonly VerilogTranslator translator = new();
    private List<TruthTableRow> rows = new();
    private readonly TruthTableGenerator generator = new();
    private bool resultsDirty = true;
    private string errorMessage = string.Empty;
    private string moduleName = "demo";
    private bool useSystemVerilog = true;
    private string verilogText = string.Empty;
    private string verilogErrorMessage = string.Empty;

    private string GetImportErrorSummary()
    {
        string firstLine = importErrorMessage.Split('\n', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? importErrorMessage;
        return firstLine.Length > 300 ? firstLine[..300] + "..." : firstLine;
    }

    private string GetDownloadFileName() => useSystemVerilog ? $"{moduleName}.sv" : $"{moduleName}.v";

    private async Task DownloadVerilogAsync()
    {
        if (!string.IsNullOrEmpty(verilogText))
        {
            await JS.InvokeVoidAsync("downloadTextFile", GetDownloadFileName(), verilogText);
        }
    }

    public void GenerateAnalysis()
    {
        resultsDirty = true;
        InvalidateVerilog();
        StateHasChanged();
    }

    private void GenerateTruthTable()
    {
        errorMessage = string.Empty;
        try
        {
            rows = generator.Generate(Manager);
            resultsDirty = false;
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
            resultsDirty = true;
            rows.Clear();
        }
    }

    private void InvalidateVerilog()
    {
        verilogText = string.Empty;
        verilogErrorMessage = string.Empty;
    }

    private void GenerateVerilog()
    {
        InvalidateVerilog();
        try
        {
            verilogText = translator.ExportToVerilog(Manager, moduleName, useSystemVerilog);
        }
        catch (Exception ex)
        {
            verilogErrorMessage = ex.Message;
        }
    }

    private async Task LoadHdlFileAsync(InputFileChangeEventArgs e)
    {
        try
        {
            string extension = Path.GetExtension(e.File.Name);
            if (!extension.Equals(".sv", StringComparison.OrdinalIgnoreCase) &&
                !extension.Equals(".v", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Select a .sv or .v file.");
            await using var stream = e.File.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            await ImportHdlFileAsync(new HdlSourceFile
            {
                FileName = e.File.Name,
                Source = await reader.ReadToEndAsync()
            });
        }
        catch (Exception ex)
        {
            importErrorMessage = ex.Message;
        }
    }

    public async Task ImportHdlFileAsync(HdlSourceFile file)
    {
        if (isImporting)
            throw new InvalidOperationException("Wait for the current HDL import to finish.");
        hdlText = file.Source;
        hdlFileName = file.FileName;
        importTopModule = file.FindTopModule();
        previousSuggestion = importTopModule;
        await ImportFromVerilog();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ImportFromVerilog()
    {
        if (isImporting) return;

        importErrorMessage = string.Empty;
        importDiagnostics = string.Empty;

        if (string.IsNullOrWhiteSpace(hdlText))
        {
            importErrorMessage = "HDL code is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(importTopModule))
        {
            importErrorMessage = "Top module name is required.";
            return;
        }

        isImporting = true;
        await InvokeAsync(StateHasChanged);
        bool circuitImported = false;

        try
        {
            var request = new HdlSynthesisRequest
            {
                Source = hdlText,
                TopModule = importTopModule
            };

            var result = await ImportClient.SynthesizeAsync(request);
            importDiagnostics = result.Diagnostics;

            var temporaryManager = adapter.ImportFromJson(result.NetlistJson, request.TopModule);
            Manager.ReplaceWith(temporaryManager);

            rows.Clear();
            errorMessage = string.Empty;
            resultsDirty = true;
            InvalidateVerilog();

            circuitImported = true;
            await OnCircuitChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            importErrorMessage = circuitImported
                ? $"The circuit was imported, but refreshing the board failed: {ex.Message}"
                : ex.Message;
        }
        finally
        {
            isImporting = false;
        }
    }
}