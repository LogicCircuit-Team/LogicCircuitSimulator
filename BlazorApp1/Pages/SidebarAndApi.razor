@using LogicCore.Management
@using LogicCore.Gates
@using LogicCore.Interfaces
@using LogicCore.Serialization
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Components.Forms
@using System.IO
@using BlazorApp1.Services

@inject IJSRuntime JS
@inject CircuitApiClient CircuitApi

<section class="tool-section">
<h3 class="tool-section-title">Components</h3>
<div class="gate-grid">
    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddSwitchAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M2 28 H20 L43 13 M49 28 H78" />
            <circle cx="20" cy="28" r="3" />
            <circle cx="49" cy="28" r="3" />
        </svg>
        <span>SWITCH</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddLampAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M2 24 H19 M53 24 H78" />
            <circle cx="36" cy="24" r="16" />
            <path d="M25 13 L47 35 M47 13 L25 35" />
        </svg>
        <span>LAMP</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddAndAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 16 H12 M0 32 H12 M50 24 H78" />
            <path d="M12 8 H34 A16 16 0 0 1 34 40 H12 Z" />
        </svg>
        <span>AND</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddNandAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 16 H12 M0 32 H12 M59 24 H78" />
            <path d="M12 8 H34 A16 16 0 0 1 34 40 H12 Z" />
            <circle cx="54" cy="24" r="4" />
        </svg>
        <span>NAND</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddOrAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 16 H17 M0 32 H17 M54 24 H78" />
            <path d="M12 8 Q25 24 12 40 Q34 40 54 24 Q34 8 12 8 Z" />
        </svg>
        <span>OR</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddNorAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 16 H17 M0 32 H17 M63 24 H78" />
            <path d="M12 8 Q25 24 12 40 Q34 40 54 24 Q34 8 12 8 Z" />
            <circle cx="58" cy="24" r="4" />
        </svg>
        <span>NOR</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddNotAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 24 H10 M58 24 H78" />
            <path d="M10 8 L48 24 L10 40 Z" />
            <circle cx="54" cy="24" r="4" />
        </svg>
        <span>NOT</span>
    </button>

    <button type="button" disabled="@isBusy" class="gate-tool" @onclick="AddXorAsync">
        <svg class="gate-symbol" viewBox="0 0 80 48" aria-hidden="true">
            <path d="M0 16 H17 M0 32 H17 M54 24 H78" />
            <path d="M6 8 Q19 24 6 40" />
            <path d="M12 8 Q25 24 12 40 Q34 40 54 24 Q34 8 12 8 Z" />
        </svg>
        <span>XOR</span>
    </button>
</div>
</section>
<section class="tool-section">
<h3 class="tool-section-title">Files and saved circuits</h3>
<div class="file-wrapper">
    <InputFile id="upload"
               OnChange="LoadCircuitAsync"
               accept=".json,.sv,.v,application/json,text/plain"
               disabled="@isBusy"
               class="file-input" />

    <label for="upload" class="file-btn">Import file</label>
    <span class="file-name">@SelectedFileName</span>
</div>

<p class="text-danger">@LoadError</p>

<label for="saved-circuit-name" class="form-label">Circuit name</label>
<input id="saved-circuit-name" class="form-control api-control" @bind="CircuitName" maxlength="100" disabled="@isBusy" placeholder="Circuit name" />

<button type="button" disabled="@isBusy" class="btn btn-primary api-control" @onclick="SaveToApiAsync">
    Save
</button>

<button type="button" disabled="@isBusy" class="btn btn-warning api-control" @onclick="UpdateSavedCircuitAsync">
    Update selected circuit
</button>

<button type="button" disabled="@isBusy" class="btn btn-secondary api-control" @onclick="LoadSavedCircuitsAsync">
    Refresh saved circuits
</button>

<select class="form-select api-control" @bind="ApiLoadId" disabled="@isBusy">
    <option value="0">Select a circuit</option>
    @foreach (var circuit in SavedCircuits)
    {
        <option value="@circuit.CircuitId">
            @circuit.Name (ID: @circuit.CircuitId)
        </option>
    }
</select>

<button type="button" disabled="@isBusy" class="btn btn-info api-control" @onclick="LoadFromApiAsync">
    Load selected circuit
</button>
<button type="button" disabled="@isBusy" class="btn btn-outline-danger api-control" @onclick="DeleteSavedCircuitAsync">
    Delete selected circuit
</button>
@if (isBusy)
{
    <p role="status">Working...</p>
}
<p>@ApiListMessage</p>
<p>@ApiLoadMessage</p>
<p class="text-info">@ApiMessage</p>

<button type="button" disabled="@isBusy" class="btn btn-primary w-100 mb-2" @onclick="SaveCircuitAsync">
    Download Circuit
</button>
<button type="button" disabled="@isBusy"
        class="btn btn-danger api-control"
        @onclick="ClearBoardAsync">
    Clear Board
</button>
<p class="form-text">Saved circuits are linked to this browser.</p>
</section>

@code {
    [Parameter]
    public CircuitManager Manager { get; set; } = default!;
    [Parameter]
    public EventCallback OnCircuitChanged { get; set; }
    [Parameter]
    public EventCallback<HdlSourceFile> OnHdlFileSelected { get; set; }

    private string SelectedFileName = "No file chosen";
    private string CircuitName = "My Circuit";
    private string? ApiMessage;
    private string? LoadError;
    private int ApiLoadId;
    private List<SavedCircuitDto> SavedCircuits = new();
    private string? ApiListMessage;
    private string? ApiLoadMessage;
    private bool isBusy;

    private (double X, double Y) GetNextPosition()
    {
        int index = Manager.Gates.Count;
        return (180 + (index % 4) * 160, 120 + (index / 4) * 110);
    }

    private async Task AddGateAsync(IGate gate)
    {
        var position = GetNextPosition();
        gate.X = position.X;
        gate.Y = position.Y;
        Manager.AddGate(gate);
        await OnCircuitChanged.InvokeAsync();
    }

    private Task AddAndAsync() => AddGateAsync(new AndGate());
    private Task AddOrAsync() => AddGateAsync(new ORGate());
    private Task AddNotAsync() => AddGateAsync(new NotGate());
    private Task AddNorAsync() => AddGateAsync(new NOR());
    private Task AddNandAsync() => AddGateAsync(new NANDGate());
    private Task AddLampAsync() => AddGateAsync(new Lamp());
    private Task AddSwitchAsync() => AddGateAsync(new Switch());
    private Task AddXorAsync() => AddGateAsync(new XORGate());

    private async Task ClearBoardAsync()
    {
        Manager.Clear();
        SelectedFileName = "No file chosen";
        LoadError = null;
        ApiLoadMessage = null;
        await OnCircuitChanged.InvokeAsync();
    }

    private async Task SaveCircuitAsync()
    {
        LoadError = null;
        try
        {
            var json = CircuitSerializer.ToJson(Manager);
            await JS.InvokeVoidAsync("downloadTextFile", "circuit.json", json);
        }
        catch (Exception ex)
        {
            LoadError = $"Download failed: {ex.Message}";
        }
    }

    private async Task ApplyLoadedCircuitAsync(CircuitManager loadedManager)
    {
        Manager.ReplaceWith(loadedManager);
        try
        {
            await OnCircuitChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException($"The circuit was loaded, but refreshing the board failed: {ex.Message}", ex);
        }
    }

    private async Task LoadCircuitAsync(InputFileChangeEventArgs e)
    {
        if (isBusy)
            return;
        isBusy = true;
        LoadError = null;
        try
        {
            await using var stream = e.File.OpenReadStream(1_000_000);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            string extension = Path.GetExtension(e.File.Name);
            if (extension.Equals(".sv", StringComparison.OrdinalIgnoreCase) ||
                extension.Equals(".v", StringComparison.OrdinalIgnoreCase))
            {
                if (!OnHdlFileSelected.HasDelegate)
                    throw new InvalidOperationException("HDL file import is not connected.");
                await OnHdlFileSelected.InvokeAsync(new HdlSourceFile { FileName = e.File.Name, Source = json });
                SelectedFileName = e.File.Name;
                return;
            }
            if (!extension.Equals(".json", StringComparison.OrdinalIgnoreCase))
                throw new InvalidOperationException("Select a .json, .sv or .v file.");
            var loadedManager = CircuitSerializer.FromJsonToManager(json);
            await ApplyLoadedCircuitAsync(loadedManager);
            SelectedFileName = e.File.Name;
        }
        catch (Exception ex)
        {
            LoadError = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task SaveToApiAsync()
    {
        if (isBusy)
            return;
        ApiMessage = null;
        if (string.IsNullOrWhiteSpace(CircuitName))
        {
            ApiMessage = "Enter a circuit name.";
            return;
        }
        isBusy = true;
        try
        {
            var saved = await CircuitApi.CreateAsync(CircuitName, CircuitSerializer.ToJson(Manager));
            SavedCircuits.Insert(0, saved);
            ApiLoadId = saved.CircuitId;
            ApiMessage = $"Saved successfully. Circuit ID: {saved.CircuitId}";
        }
        catch (Exception ex)
        {
            ApiMessage = $"Save failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadFromApiAsync()
    {
        if (isBusy)
            return;
        ApiLoadMessage = null;
        if (ApiLoadId <= 0)
        {
            ApiLoadMessage = "Select a saved circuit first.";
            return;
        }
        isBusy = true;
        try
        {
            var saved = await CircuitApi.GetByIdAsync(ApiLoadId);
            if (saved == null)
            {
                ApiLoadMessage = "Circuit was not found.";
                return;
            }
            var loaded = CircuitSerializer.FromJsonToManager(saved.JsonData);
            await ApplyLoadedCircuitAsync(loaded);
            CircuitName = saved.Name;
            ApiLoadMessage = $"Loaded successfully: {saved.Name}";
        }
        catch (Exception ex)
        {
            ApiLoadMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task LoadSavedCircuitsAsync()
    {
        if (isBusy)
            return;
        isBusy = true;
        ApiListMessage = null;
        try
        {
            SavedCircuits = await CircuitApi.GetAllAsync();
            if (!SavedCircuits.Any(c => c.CircuitId == ApiLoadId))
                ApiLoadId = SavedCircuits.FirstOrDefault()?.CircuitId ?? 0;
            ApiListMessage = SavedCircuits.Count == 0
                ? "No saved circuits found."
                : $"Found {SavedCircuits.Count} saved circuit(s).";
        }
        catch (Exception ex)
        {
            ApiListMessage = ex.Message;
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task UpdateSavedCircuitAsync()
    {
        if (isBusy)
            return;
        ApiMessage = null;
        if (ApiLoadId <= 0 || string.IsNullOrWhiteSpace(CircuitName))
        {
            ApiMessage = "Select a saved circuit and enter a name.";
            return;
        }
        isBusy = true;
        try
        {
            var json = CircuitSerializer.ToJson(Manager);
            await CircuitApi.UpdateAsync(ApiLoadId, CircuitName, json);
            var saved = SavedCircuits.FirstOrDefault(c => c.CircuitId == ApiLoadId);
            if (saved != null)
            {
                saved.Name = CircuitName.Trim();
                saved.JsonData = json;
            }
            ApiMessage = $"Circuit {ApiLoadId} updated successfully.";
        }
        catch (Exception ex)
        {
            ApiMessage = $"Update failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task DeleteSavedCircuitAsync()
    {
        if (isBusy)
            return;
        ApiMessage = null;
        if (ApiLoadId <= 0)
        {
            ApiMessage = "Select a saved circuit first.";
            return;
        }
        isBusy = true;
        try
        {
            int id = ApiLoadId;
            if (!await JS.InvokeAsync<bool>("confirm", $"Delete saved circuit {id}?"))
                return;
            await CircuitApi.DeleteAsync(id);
            SavedCircuits.RemoveAll(c => c.CircuitId == id);
            ApiLoadId = SavedCircuits.FirstOrDefault()?.CircuitId ?? 0;
            ApiMessage = $"Saved circuit {id} deleted.";
        }
        catch (Exception ex)
        {
            ApiMessage = $"Delete failed: {ex.Message}";
        }
        finally
        {
            isBusy = false;
        }
    }
}
