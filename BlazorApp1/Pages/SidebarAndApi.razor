@using LogicCore.Management
@using LogicCore.Interfaces
@using LogicCore.Gates

<div class="d-flex flex-wrap gap-2 p-1">
    <button class="btn btn-primary" @onclick='() => Add(new AndGate())'>AND</button>
    <button class="btn btn-primary" @onclick='() => Add(new ORGate())'>OR</button>
    <button class="btn btn-primary" @onclick='() => Add(new NotGate())'>NOT</button>
    <button class="btn btn-primary" @onclick='() => Add(new NANDGate())'>NAND</button>
    <button class="btn btn-primary" @onclick='() => Add(new NOR())'>NOR</button>
    <button class="btn btn-primary" @onclick='() => Add(new XORGate())'>XOR</button>
    <button class="btn btn-success" @onclick='() => Add(new Switch())'>SWITCH</button>
    <button class="btn btn-success" @onclick='() => Add(new Lamp())'>LAMP</button>
    <button class="btn btn-danger" @onclick="Clear">Clear</button>
</div>

@code {
    [Parameter] public CircuitManager Manager { get; set; } = default!;
    [Parameter] public EventCallback OnCircuitChanged { get; set; }

    private async Task Add(IGate gate)
    {
        // حساب موضع جديد متسلسل لكل بوابة مضافة
        int count = Manager.Gates.Count;
        gate.X = 70 + (count % 4) * 160;
        gate.Y = 50 + (count / 4) * 110;

        Manager.AddGate(gate);
        await OnCircuitChanged.InvokeAsync();
    }

    private async Task Clear()
    {
        Manager.Clear();
        await OnCircuitChanged.InvokeAsync();
    }
}