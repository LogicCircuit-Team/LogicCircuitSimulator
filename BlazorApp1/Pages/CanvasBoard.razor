@using System
@using System.Linq
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using LogicCore.Management
@using LogicCore.Interfaces
@using LogicCore.Connections
@using LogicCore.Gates
@using LogicCore.Simulation
@using LogicCore.Validation

@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="canvas-board-wrapper" style="position:relative; display:flex; flex-direction:column; width:100%; height:100%; min-height:0;">
    <div class="board-toolbar command-bar border-bottom" role="toolbar" aria-label="Circuit tools">
        <button type="button" class="btn panel-toggle" data-panel-toggle="library" aria-expanded="true" aria-controls="component-library" aria-label="Open components" title="Components"><i class="bi bi-grid" aria-hidden="true"></i><span class="desktop-only">Components</span></button>

        <div class="tool-group tool-cluster">
            <button type="button" class="btn @(_isPanMode ? "active" : "")" @onclick="TogglePanModeAsync" aria-pressed="@_isPanMode" title="Pan board" aria-label="Pan board"><i class="bi bi-hand-index" aria-hidden="true"></i><span class="desktop-only">Pan</span></button>
            <button type="button" class="btn" @onclick="DeleteSelectedAsync" disabled="@(_selectedGate == null && _selectedWire == null)" title="Delete selected" aria-label="Delete selected"><i class="bi bi-trash3" aria-hidden="true"></i></button>
            <button type="button" class="btn desktop-only" @onclick="ClearBoardAsync" title="Clear board" aria-label="Clear board"><i class="bi bi-file-earmark" aria-hidden="true"></i><span class="desktop-only">New</span></button>
        </div>

        <div class="tool-group tool-cluster">
            @if (!_isEducationalMode)
            {
                <button type="button" class="btn btn-success" @onclick="StartEducationalModeAsync" title="Step mode" aria-label="Step mode"><i class="bi bi-play-fill" aria-hidden="true"></i><span class="desktop-only">Step mode</span></button>
            }
            else
            {
                <button type="button" class="btn btn-success" @onclick="ExecuteNextStepAsync" title="Next step"><i class="bi bi-skip-forward-fill" aria-hidden="true"></i><span>Next (@(_stepSimulator?.StepCount ?? 0))</span></button>
                <button type="button" class="btn" @onclick="ResetEducationalAsync" title="Reset steps" aria-label="Reset steps"><i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i></button>
                <button type="button" class="btn" @onclick="ExitEducationalModeAsync" title="Run simulation"><i class="bi bi-play-circle" aria-hidden="true"></i><span class="desktop-only">Run</span></button>
            }
        </div>

        <button type="button" class="btn truth-table-shortcut" data-truth-table aria-haspopup="dialog" aria-controls="truth-table-dialog" title="Open truth table"><i class="bi bi-table" aria-hidden="true"></i><span>Truth Table</span></button>
        <div class="tool-group command-end">
            <button type="button" class="btn desktop-only" @onclick="FitCircuitAsync" title="Fit circuit" aria-label="Fit circuit"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i><span class="desktop-only">Fit circuit</span></button>
            <button type="button" class="btn panel-toggle" data-panel-toggle="analysis" aria-expanded="true" aria-controls="analysis-inspector" aria-label="Open analysis" title="Analysis & HDL"><i class="bi bi-sliders" aria-hidden="true"></i><span class="desktop-only">Analysis</span></button>
        </div>
    </div>

    <div class="status-banner @GetStatusCssClass()">
        <span>@_statusMessage</span>

        @if (!string.IsNullOrWhiteSpace(_engineInitError))
        {
            <span class="badge bg-label-danger text-wrap">@_engineInitError</span>
        }

        @if (!string.IsNullOrWhiteSpace(_validationMessage))
        {
            <span class="badge bg-label-danger text-wrap">@_validationMessage</span>
        }

        @if (Manager?.HasFeedbackLoop == true)
        {
            <span class="badge bg-label-danger text-wrap">Feedback loop detected</span>
        }
    </div>

    <div class="canvas-viewport" id="@_viewportId" style="position:relative; flex:1 1 auto; width:100%; height:100%; min-height:360px; overflow:hidden;">
        <canvas id="@($"{_viewportId}-grid")" class="canvas-layer canvas-grid-layer" aria-hidden="true" style="position:absolute; inset:0; width:100%; height:100%; display:block; z-index:1; pointer-events:none;"></canvas>
        <canvas id="@($"{_viewportId}-scene")" class="canvas-layer canvas-scene-layer" aria-label="Interactive logic circuit canvas" style="position:absolute; inset:0; width:100%; height:100%; display:block; z-index:2;"></canvas>
    </div>

    <div class="canvas-scroll-horizontal">
        <input type="range" min="@Coordinate(PanMinimumX)" max="@Coordinate(PanMaximumX)" step="1" value="@Coordinate(-_panX / _zoom)" @oninput="SlideHorizontalAsync" aria-label="Move canvas horizontally" />
    </div>
    <div class="canvas-scroll-vertical">
        <input type="range" min="@Coordinate(PanMinimumY)" max="@Coordinate(PanMaximumY)" step="1" value="@Coordinate(-_panY / _zoom)" @oninput="SlideVerticalAsync" aria-label="Move canvas vertically" />
    </div>

    <div class="zoom btn-group shadow-sm" role="group" aria-label="Canvas zoom">
        <button type="button" class="btn mobile-only" @onclick="FitCircuitAsync" title="Fit circuit" aria-label="Fit circuit"><i class="bi bi-arrows-fullscreen" aria-hidden="true"></i></button>
        <button type="button" class="btn" title="Zoom out" aria-label="Zoom out" @onclick="ZoomOutAsync"><i class="bi bi-dash" aria-hidden="true"></i></button>
        <button type="button" class="btn zoom-value" title="Reset view" aria-label="Reset view" @onclick="ResetViewAsync">@($"{_zoom * 100:0}%")</button>
        <button type="button" class="btn" title="Zoom in" aria-label="Zoom in" @onclick="ZoomInAsync"><i class="bi bi-plus" aria-hidden="true"></i></button>
    </div>
    <div class="signal-key" aria-label="Green signal is one, gray signal is zero"><span></span> 1 <span></span> 0</div>

    @if (_isEducationalMode && _stepSimulator != null)
    {
        <div class="educational-panel">
            <div class="edu-header">
                <strong>@_stepSimulator.LastActionDescription</strong>
                <span class="badge bg-label-success">Step @_stepSimulator.StepCount</span>
            </div>

            <div>Simulation stage: @_stepSimulator.CurrentStage</div>
        </div>
    }
</div>

@code {
    [Parameter]
    public CircuitManager Manager { get; set; } = default!;

    [Parameter]
    public EventCallback OnBoardUpdated { get; set; }

    private readonly string _viewportId = "cv-" + Guid.NewGuid().ToString("N");
    private IJSObjectReference? _engineModule;
    private DotNetObjectReference<CanvasBoard>? _dotNetRef;
    private bool _engineInitialized;
    private string? _engineInitError;

    private int _canvasWidth = 1200;
    private int _canvasHeight = 700;
    private bool _redrawAfterRender;
    private bool _refreshCircuitAfterRender;
    private CircuitManager? _observedManager;

    private const double GridSize = 20;
    private const double GateWidth = 110;
    private const double GateHeight = 68;

    private double _zoom = 1;
    private double _panX;
    private double _panY;
    private bool _isPanMode;

    private IGate? _selectedGate;
    private Wire? _selectedWire;

    private bool _isEducationalMode;
    private StepSimulator? _stepSimulator;

    private string? _validationMessage;
    private string _statusMessage =
        "Drag an output pin to an input pin to connect gates. Click a switch to toggle its state.";
    private bool _isErrorStatus;

    private bool _isSyncing;
    private bool _syncPending;

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_observedManager, Manager))
        {
            _observedManager = Manager;
            ResetInteractionState();
            _refreshCircuitAfterRender = true;
            _redrawAfterRender = true;
        }
    }

    private async Task<bool> EnsureEngineInitializedAsync()
    {
        if (_engineInitialized && _engineModule != null)
            return true;

        try
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            _engineModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/canvasEngine.js");
            var size = await _engineModule.InvokeAsync<double[]>("initCanvas", _viewportId, _dotNetRef);
            if (size is { Length: >= 2 } && size[0] > 50 && size[1] > 50)
            {
                _canvasWidth = (int)Math.Round(size[0]);
                _canvasHeight = (int)Math.Round(size[1]);
            }
            _engineInitialized = true;
            _engineInitError = null;
            return true;
        }
        catch (Exception ex)
        {
            _engineInitError = $"Canvas engine error: {ex.Message}";
            _isErrorStatus = true;
            return false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || !_engineInitialized)
        {
            if (!await EnsureEngineInitializedAsync())
            {
                await InvokeAsync(StateHasChanged);
                return;
            }
        }

        if (_refreshCircuitAfterRender && Manager != null)
        {
            _refreshCircuitAfterRender = false;
            _redrawAfterRender = false;
            await SimulateAndRefreshAsync(geometryChanged: true);
        }
        else if ((firstRender || _redrawAfterRender) && Manager != null)
        {
            _redrawAfterRender = false;
            await RequestDrawAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _engineInitialized = false;
        if (_engineModule != null)
        {
            try
            {
                await _engineModule.InvokeVoidAsync("disposeCanvas", _viewportId);
                await _engineModule.DisposeAsync();
            }
            catch (JSException) { }
            catch (ObjectDisposedException) { }
        }
        _dotNetRef?.Dispose();
    }

    private async Task MeasureViewportAsync()
    {
        if (!await EnsureEngineInitializedAsync() || _engineModule == null)
            return;

        try
        {
            var size = await _engineModule.InvokeAsync<double[]>("measureViewport", _viewportId);
            if (size is { Length: >= 2 })
            {
                int w = (int)Math.Round(size[0]);
                int h = (int)Math.Round(size[1]);
                if (w > 50 && h > 50)
                {
                    _canvasWidth = w;
                    _canvasHeight = h;
                }
            }
        }
        catch (JSException)
        {
        }
    }

    private async Task RequestDrawAsync()
    {
        if (Manager == null)
            return;

        if (!await EnsureEngineInitializedAsync() || _engineModule == null)
        {
            _redrawAfterRender = true;
            return;
        }

        if (_isSyncing)
        {
            _syncPending = true;
            return;
        }

        _isSyncing = true;
        try
        {
            do
            {
                _syncPending = false;
                var payload = BuildScenePayload();
                await _engineModule.InvokeVoidAsync("syncScene", _viewportId, payload);
            }
            while (_syncPending);
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task RequestSignalSyncAsync()
    {
        if (Manager == null)
            return;

        if (!await EnsureEngineInitializedAsync() || _engineModule == null)
        {
            _redrawAfterRender = true;
            return;
        }

        if (_presentationGeometryHash == null)
        {
            await RequestDrawAsync();
            return;
        }

        var delta = BuildSignalDeltaPayload();
        await _engineModule.InvokeVoidAsync("syncSignals", _viewportId, delta);
    }

    private async Task SyncViewportOnlyAsync()
    {
        if (await EnsureEngineInitializedAsync() && _engineModule != null)
        {
            await _engineModule.InvokeVoidAsync("setViewport", _viewportId, _panX, _panY, _zoom, _isPanMode);
        }
        await InvokeAsync(StateHasChanged);
    }

    public Task RedrawAsync()
    {
        return InvokeAsync(async () =>
        {
            ResetInteractionState();
            _observedManager = Manager;
            _refreshCircuitAfterRender = false;
            await MeasureViewportAsync();
            if (!_initialMobileFitDone && _canvasWidth > 50 && _canvasWidth < 768 && Manager.Gates.Count > 0)
            {
                _initialMobileFitDone = true;
                FitCircuit();
            }
            SetStatus("Circuit updated.", false);
            await SimulateAndRefreshAsync(geometryChanged: true);
        });
    }

    private async Task SimulateAndRefreshAsync(bool geometryChanged = true)
    {
        if (Manager == null)
            return;

        var result = Manager.TrySimulate();
        _validationMessage = result.IsValid ? null : result.Message;

        if (!result.IsValid)
            SetStatus("The circuit could not be evaluated. Check its connections.", true);

        if (geometryChanged || _presentationGeometryHash == null)
        {
            await RequestDrawAsync();
        }
        else
        {
            await RequestSignalSyncAsync();
        }

        await InvokeAsync(StateHasChanged);
    }

    private void ResetInteractionState()
    {
        _selectedGate = null;
        _selectedWire = null;
        _isPanMode = false;
        _presentationGeometryHash = null;
        _validationMessage = null;
        _isErrorStatus = false;

        _stepSimulator = null;
        _isEducationalMode = false;
    }

    private async Task NotifyUserModificationAsync(bool geometryChanged = true)
    {
        if (Manager == null)
            return;

        _stepSimulator = null;
        _isEducationalMode = false;
        if (geometryChanged)
        {
            _presentationGeometryHash = null;
        }

        await SimulateAndRefreshAsync(geometryChanged);

        if (OnBoardUpdated.HasDelegate)
            await OnBoardUpdated.InvokeAsync();
    }

    private async Task RefreshAsync()
    {
        await RequestDrawAsync();
        await InvokeAsync(StateHasChanged);
    }

    private (double X, double Y) ScreenToCircuit(double screenX, double screenY)
    {
        return (
            (screenX - _panX) / _zoom,
            (screenY - _panY) / _zoom
        );
    }

    private static double SnapToGrid(double value)
    {
        return Math.Round(value / GridSize) * GridSize;
    }

    private static (double X, double Y) GetOutputPinPosition(IGate gate)
    {
        return (gate.X + GateWidth, gate.Y + GateHeight / 2);
    }

    private static (double X, double Y) GetInputPinPosition(IGate gate, int inputIndex)
    {
        int count = gate.Inputs?.Length ?? 0;

        if (count <= 1)
            return (gate.X, gate.Y + GateHeight / 2);

        double spacing = GateHeight / (count + 1);

        return (gate.X, gate.Y + spacing * (inputIndex + 1));
    }

    private void FitCircuit()
    {
        if (Manager.Gates.Count == 0 || _canvasWidth <= 100 || _canvasHeight <= 100) return;
        double left = Manager.Gates.Min(gate => gate.X) - 25;
        double top = Manager.Gates.Min(gate => gate.Y) - 25;
        double width = Math.Max(GateWidth + 50, Manager.Gates.Max(gate => gate.X) + GateWidth + 25 - left);
        double height = Math.Max(GateHeight + 50, Manager.Gates.Max(gate => gate.Y) + GateHeight + 25 - top);
        _zoom = Math.Clamp(Math.Min((_canvasWidth - 40) / width, (_canvasHeight - 40) / height), 0.2, 1.5);
        _panX = (_canvasWidth - width * _zoom) / 2 - left * _zoom;
        _panY = (_canvasHeight - height * _zoom) / 2 - top * _zoom;
    }

    private async Task FitCircuitAsync()
    {
        await MeasureViewportAsync();
        FitCircuit();
        await SyncViewportOnlyAsync();
    }

    private bool IsInputOccupied(IGate gate, int index)
    {
        for (int i = 0; i < Manager.Wires.Count; i++)
        {
            var w = Manager.Wires[i];
            if (ReferenceEquals(w.TargetGate, gate) && w.TargetInputIndex == index)
                return true;
        }
        return false;
    }

    private async Task CompleteWireConnectionAsync(
        IGate source,
        IGate target,
        int targetInputIndex)
    {
        var validation = Manager.TryAddWire(new Wire(source, target, targetInputIndex));

        if (!validation.IsValid)
        {
            RejectConnection($"Connection rejected: {validation.Message}");
            await RefreshAsync();
            return;
        }

        _validationMessage = null;

        SetStatus(
            $"Connected: {source.GateType} → {target.GateType} (In{targetInputIndex}).",
            false);

        await NotifyUserModificationAsync(geometryChanged: true);
    }

    private void RejectConnection(string message)
    {
        _validationMessage = message;
        SetStatus(message, true);
    }

    private void RemoveWireSafely(Wire wire)
    {
        var target = wire.TargetGate;
        int index = wire.TargetInputIndex;

        Manager.RemoveWire(wire);

        ResetInputIfFree(target, index);

        if (ReferenceEquals(_selectedWire, wire))
            _selectedWire = null;
    }

    private void RemoveGateSafely(IGate gate)
    {
        var affected = new List<(IGate Gate, int Index)>();
        for (int i = 0; i < Manager.Wires.Count; i++)
        {
            var w = Manager.Wires[i];
            if (ReferenceEquals(w.SourceGate, gate) && w.TargetGate != null && !ReferenceEquals(w.TargetGate, gate))
            {
                affected.Add((w.TargetGate, w.TargetInputIndex));
            }
        }

        Manager.RemoveGate(gate);

        for (int i = 0; i < affected.Count; i++)
        {
            ResetInputIfFree(affected[i].Gate, affected[i].Index);
        }

        if (ReferenceEquals(_selectedGate, gate))
            _selectedGate = null;
    }

    private void ResetInputIfFree(IGate? gate, int index)
    {
        if (gate == null || index < 0 || IsInputOccupied(gate, index))
            return;

        if (gate.Inputs != null && index < gate.Inputs.Length)
            gate.Inputs[index] = false;
    }

    private void ZoomAt(double screenX, double screenY, double factor)
    {
        var (cx, cy) = ScreenToCircuit(screenX, screenY);

        _zoom = Math.Clamp(_zoom * factor, 0.2, 2.5);

        _panX = screenX - cx * _zoom;
        _panY = screenY - cy * _zoom;
    }

    private async Task ZoomInAsync()
    {
        ZoomAt(_canvasWidth / 2.0, _canvasHeight / 2.0, 1.15);
        await SyncViewportOnlyAsync();
    }

    private async Task ZoomOutAsync()
    {
        ZoomAt(_canvasWidth / 2.0, _canvasHeight / 2.0, 1 / 1.15);
        await SyncViewportOnlyAsync();
    }

    private async Task ResetViewAsync()
    {
        _zoom = 1;
        _panX = 0;
        _panY = 0;

        await SyncViewportOnlyAsync();
    }

    private async Task TogglePanModeAsync()
    {
        _isPanMode = !_isPanMode;

        SetStatus(
            _isPanMode ? "Pan mode enabled." : "Pan mode disabled.",
            false);

        await SyncViewportOnlyAsync();
    }

    private async Task DeleteSelectedAsync()
    {
        if (Manager == null)
            return;

        if (_selectedWire != null)
        {
            RemoveWireSafely(_selectedWire);
            _selectedWire = null;
            _presentationGeometryHash = null;

            SetStatus("Selected wire deleted.", false);
            await NotifyUserModificationAsync(geometryChanged: true);
            return;
        }

        if (_selectedGate != null)
        {
            string type = _selectedGate.GateType;

            RemoveGateSafely(_selectedGate);
            _selectedGate = null;
            _presentationGeometryHash = null;

            SetStatus($"Deleted {type} and its attached wires.", false);
            await NotifyUserModificationAsync(geometryChanged: true);
        }
    }

    private async Task ClearBoardAsync()
    {
        if (Manager == null)
            return;

        Manager.Clear();

        ResetInteractionState();

        SetStatus("All gates and wires cleared.", false);

        await NotifyUserModificationAsync(geometryChanged: true);
    }

    private async Task StartEducationalModeAsync()
    {
        if (Manager == null)
            return;

        _isEducationalMode = true;
        _stepSimulator = new StepSimulator(Manager);
        _stepSimulator.Reset();

        SetStatus("Step mode started. Use Next step to continue.", false);

        await RequestSignalSyncAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExecuteNextStepAsync()
    {
        if (Manager == null)
            return;

        _stepSimulator ??= new StepSimulator(Manager);
        _stepSimulator.ExecuteNextStep();

        SetStatus(_stepSimulator.LastActionDescription, Manager.HasFeedbackLoop);

        await RequestSignalSyncAsync();
        await InvokeAsync(StateHasChanged);

        if (OnBoardUpdated.HasDelegate)
            await OnBoardUpdated.InvokeAsync();
    }

    private async Task ResetEducationalAsync()
    {
        if (Manager == null)
            return;

        _stepSimulator ??= new StepSimulator(Manager);
        _stepSimulator.Reset();

        SetStatus("Simulation steps reset.", false);

        await RequestSignalSyncAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExitEducationalModeAsync()
    {
        _isEducationalMode = false;
        _stepSimulator = null;

        SetStatus("Full simulation resumed.", false);

        await NotifyUserModificationAsync(geometryChanged: false);
    }

    private void SetStatus(string message, bool isError)
    {
        _statusMessage = message;
        _isErrorStatus = isError;
    }

    private string GetStatusCssClass()
    {
        if (_isErrorStatus || !string.IsNullOrWhiteSpace(_engineInitError) || (Manager?.HasFeedbackLoop ?? false))
            return "status-error";

        if (_isEducationalMode)
            return "status-edu";

        return "status-normal";
    }
}