@page "/"
@layout WorkspaceLayout
@using LogicCore.Management
@using BlazorApp1.Services
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Logic Space · Logic Circuit Simulator</PageTitle>

<div class="logic-home" dir="ltr">
    <header class="app-header">
        <span class="identity" aria-label="Logic Space circuit simulator">
            <i class="bi bi-cpu" aria-hidden="true"></i><b>Logic Space</b>
        </span>
        <span class="header-separator"></span>
        <span class="project-caption">Circuit workbench</span>
        <nav class="header-actions" aria-label="Workspace navigation">
            <button type="button" class="btn btn-sm @(!showCommunity ? "btn-success" : "btn-outline-secondary")" @onclick="ShowWorkspace" aria-pressed="@(!showCommunity)">
                <i class="bi bi-diagram-3" aria-hidden="true"></i><span> Workspace</span>
            </button>
            <button type="button" class="btn btn-sm @(showCommunity ? "btn-success" : "btn-outline-secondary")" @onclick="ShowCommunity" aria-pressed="@showCommunity">
                <i class="bi bi-people" aria-hidden="true"></i><span> Community</span>
            </button>
        </nav>
    </header>

    <div hidden="@showCommunity" class="workspace-view">
        <div class="editor">
            <aside class="offcanvas-lg offcanvas-start library" tabindex="-1" id="component-library" aria-labelledby="tools-title">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title h6 mb-0">Components &amp; files</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#component-library" aria-label="Close components"></button>
                </div>
                <h2 class="panel-title desktop-only" id="tools-title">Component library</h2>
                <div class="library-body">
                    <SidebarAndApi Manager="@sharedManager" OnCircuitChanged="RefreshAll" OnHdlFileSelected="ImportHdlFileAsync" />
                </div>
                <p class="library-foot">ADD → CONNECT → TEST<br />Choose a component. Drag its pins to connect.<br />Toggle an input to follow the signal.</p>
            </aside>

            <div class="panel-resizer library-resizer" role="separator" aria-label="Resize component library" aria-orientation="vertical" aria-valuemin="190" aria-valuemax="380" aria-valuenow="230" tabindex="0" data-resize-panel="library"></div>
            <main class="workbench" aria-labelledby="canvas-title">
                <div class="circuit-tab">
                    <i class="bi bi-diagram-3 me-2" aria-hidden="true"></i>
                    <h1 class="mb-0" id="canvas-title">Circuit workspace</h1>
                    <span class="ms-auto">Main</span>
                </div>
                <div id="canvasHost">
                    <CanvasBoard @ref="canvasBoard" Manager="@sharedManager" OnBoardUpdated="RefreshAnalysis" />
                </div>
            </main>

            <div class="panel-resizer analysis-resizer" role="separator" aria-label="Resize analysis panel" aria-orientation="vertical" aria-valuemin="260" aria-valuemax="460" aria-valuenow="290" tabindex="0" data-resize-panel="analysis"></div>
            <aside class="offcanvas-lg offcanvas-end inspector" tabindex="-1" id="analysis-inspector" aria-labelledby="analysis-title">
                <div class="offcanvas-header">
                    <h2 class="offcanvas-title h6 mb-0">Analysis &amp; HDL</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#analysis-inspector" aria-label="Close analysis"></button>
                </div>
                <h2 class="panel-title desktop-only" id="analysis-title">Analysis &amp; HDL</h2>
                <div class="analysis-body">
                    <AnalysisPanel @ref="analysisPanel" Manager="@sharedManager" OnCircuitChanged="RefreshAll" />
                </div>
                <section class="circuit-status" aria-label="Circuit status">
                    <h2 class="panel-title">Circuit status</h2>
                    <dl>
                        <dt>Components</dt>
                        <dd>@sharedManager.Gates.Count</dd>
                        <dt>Connections</dt>
                        <dd>@sharedManager.Wires.Count</dd>
                    </dl>
                    <p>Click a switch to toggle 0 / 1. Green wires carry a high signal.</p>
                </section>
            </aside>
        </div>
    </div>

    <main hidden="@(!showCommunity)" class="community-view" aria-label="Community circuits">
        @if (communityOpened)
        {
            <CommunityPanel Manager="sharedManager" SelectedCircuitId="SharedCircuitId" OnCircuitImported="ImportSharedCircuit" />
        }
    </main>

    <footer class="app-footer">
        <span>LogicCircuit Team</span>
        <div class="footer-right"><span class="desktop-only">Combinational mode</span><span>Logic Space · Bootstrap</span></div>
    </footer>
</div>

@code {
    private readonly CircuitManager sharedManager = new();
    private CanvasBoard? canvasBoard;
    private AnalysisPanel? analysisPanel;

    [SupplyParameterFromQuery(Name = "shared")]
    public int? SharedCircuitId { get; set; }

    private bool showCommunity;
    private bool redrawWorkspace;
    private bool communityOpened;
    private int? previousSharedId;

    protected override void OnParametersSet()
    {
        if (SharedCircuitId is > 0 && previousSharedId != SharedCircuitId)
        {
            previousSharedId = SharedCircuitId;
            showCommunity = true;
            communityOpened = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (redrawWorkspace && canvasBoard != null)
        {
            redrawWorkspace = false;
            await canvasBoard.RedrawAsync();
        }
    }

    private void ShowWorkspace() { showCommunity = false; redrawWorkspace = true; }
    private void ShowCommunity() { showCommunity = true; communityOpened = true; }

    private Task ImportSharedCircuit(CircuitManager imported)
    {
        sharedManager.ReplaceWith(imported);
        showCommunity = false;
        redrawWorkspace = true;
        RefreshAnalysis();
        return Task.CompletedTask;
    }

    private async Task RefreshAll()
    {
        if (canvasBoard is not null)
        {
            await canvasBoard.RedrawAsync();
        }

        RefreshAnalysis();
        await InvokeAsync(StateHasChanged);
    }

    private void RefreshAnalysis()
    {
        analysisPanel?.GenerateAnalysis();
    }

    private Task ImportHdlFileAsync(HdlSourceFile file)
    {
        return analysisPanel?.ImportHdlFileAsync(file) ?? Task.CompletedTask;
    }
}